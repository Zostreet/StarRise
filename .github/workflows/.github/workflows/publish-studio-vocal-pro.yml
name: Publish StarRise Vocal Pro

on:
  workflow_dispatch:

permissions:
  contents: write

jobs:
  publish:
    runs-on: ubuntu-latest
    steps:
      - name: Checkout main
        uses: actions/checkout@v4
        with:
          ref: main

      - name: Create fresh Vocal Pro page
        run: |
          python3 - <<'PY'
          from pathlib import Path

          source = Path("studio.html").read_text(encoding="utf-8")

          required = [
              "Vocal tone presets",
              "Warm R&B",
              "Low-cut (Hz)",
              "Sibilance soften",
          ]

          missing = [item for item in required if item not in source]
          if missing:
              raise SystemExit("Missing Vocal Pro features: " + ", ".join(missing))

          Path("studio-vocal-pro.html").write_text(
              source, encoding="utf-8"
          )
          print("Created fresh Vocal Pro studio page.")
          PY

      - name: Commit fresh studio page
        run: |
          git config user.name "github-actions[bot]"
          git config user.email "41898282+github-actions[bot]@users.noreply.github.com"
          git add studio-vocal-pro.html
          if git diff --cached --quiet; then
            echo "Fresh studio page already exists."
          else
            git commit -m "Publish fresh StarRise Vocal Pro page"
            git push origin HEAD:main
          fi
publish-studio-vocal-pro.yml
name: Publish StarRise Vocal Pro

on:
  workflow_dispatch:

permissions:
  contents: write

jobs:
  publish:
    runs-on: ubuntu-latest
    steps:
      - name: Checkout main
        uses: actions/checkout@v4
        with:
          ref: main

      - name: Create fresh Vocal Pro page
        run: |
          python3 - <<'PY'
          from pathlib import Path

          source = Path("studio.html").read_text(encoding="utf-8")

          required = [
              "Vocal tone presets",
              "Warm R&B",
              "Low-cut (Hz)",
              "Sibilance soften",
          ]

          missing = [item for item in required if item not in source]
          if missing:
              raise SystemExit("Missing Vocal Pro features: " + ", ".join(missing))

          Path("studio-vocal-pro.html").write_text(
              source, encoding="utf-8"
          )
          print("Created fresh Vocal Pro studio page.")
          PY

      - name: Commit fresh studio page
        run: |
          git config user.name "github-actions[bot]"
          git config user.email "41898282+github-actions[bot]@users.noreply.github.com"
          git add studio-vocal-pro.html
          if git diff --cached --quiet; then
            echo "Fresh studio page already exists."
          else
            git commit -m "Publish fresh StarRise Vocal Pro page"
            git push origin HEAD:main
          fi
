
name: Publish StarRise Vocal Pro

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout main
        uses: actions/checkout@v4
        with:
          ref: main

      - name: Create fresh Vocal Pro page
        run: |
          python3 - <<'PY'
          from pathlib import Path

          source = Path("studio.html").read_text(encoding="utf-8")

          required = [
              "Vocal tone presets",
              "Warm R&B",
              "Low-cut (Hz)",
              "Sibilance soften",
          ]

          missing = [item for item in required if item not in source]
          if missing:
              raise SystemExit("Missing Vocal Pro features: " + ", ".join(missing))

          Path("studio-vocal-pro.html").write_text(
              source, encoding="utf-8"
          )
          print("Created fresh Vocal Pro studio page.")
          PY

      - name: Commit fresh studio page
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add studio-vocal-pro.html
          if git diff --cached --quiet; then
            echo "Fresh studio page already exists."
          else
            git commit -m "Publish fresh StarRise Vocal Pro page"
            git push origin HEAD:main
          fi
